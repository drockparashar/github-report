{
  "name": "github-report-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal internship report generator from GitHub commits using Gemini",
  "bin": {
    "github-report": "./bin/report.js"
  },
  "scripts": {
    "start": "node ./bin/report.js",
    "generate": "node ./bin/report.js generate",
    "help": "node ./bin/report.js --help"
  },
  "engines": {
    "node": ">=18"
  }
}
